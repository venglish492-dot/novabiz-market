# Vektor Lab — environment variables.
# Copy to .env.local and fill in. Never commit real values.
# Everything is optional: with nothing set, the storefront runs in catalog-only
# mode (browse, search, cart) and checkout/accounts show an honest
# "not available yet" state.

# --- Site ------------------------------------------------------------------
# Canonical origin used for metadata, sitemap, auth redirects and payment
# return URLs. Defaults to https://vektorlab.uz.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (auth, database, storage) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, used only if the publishable key above is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service-role key. SERVER ONLY. Used for order fulfilment, signed
# download URLs, webhooks and admin role changes. Never expose to the client.
SUPABASE_SECRET_KEY=
# Legacy name, used only if SUPABASE_SECRET_KEY is empty.
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets (created by the migration). product-files must stay private.
STORAGE_BUCKET_FILES=product-files
STORAGE_BUCKET_MEDIA=product-media
# Lifetime of signed download URLs in seconds (10–600).
DOWNLOAD_URL_TTL_SECONDS=60
# Max successful downloads per user per product per 24h (1–500).
DOWNLOAD_DAILY_LIMIT=20

# --- Payments ----------------------------------------------------------------
# Stripe Checkout. Checkout is enabled only when BOTH values are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local/staging test provider. Ignored on the production deployment; orders it
# creates are flagged is_test and excluded from revenue.
PAYMENTS_SANDBOX_ENABLED=false

# --- Email (order confirmations) ---------------------------------------------
# Resend API. Without it, order emails are skipped (the library still works).
RESEND_API_KEY=
# e.g. "Vektor Lab <hello@vektorlab.uz>" — the domain must be verified in Resend.
EMAIL_FROM=

# --- Auth --------------------------------------------------------------------
# Show "Continue with Google" only after the provider is configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Feature flags -----------------------------------------------------------
# Reviews and newsletter need Supabase; they are off automatically without it.
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_NEWSLETTER=true
# First-party analytics events (stored in Supabase). Off by default.
NEXT_PUBLIC_FEATURE_ANALYTICS=false
# Prepared in the data model, not launched.
NEXT_PUBLIC_FEATURE_CREATORS=false
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=false
