# VYBE — environment variables. Copy to .env.local and fill in what you need.
# Never commit real values. Everything is optional for local development.

# --- Site -------------------------------------------------------------------
# Public origin, used for canonical URLs, sitemap, share images and reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Secret used to salt privacy-preserving visitor hashes for unique views.
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
VYBE_SECRET=

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, RDS, local Postgres 14+).
# Leave empty to use the embedded PGlite database in VYBE_DATA_DIR/pglite —
# fine for local development and single-server deployments.
DATABASE_URL=
# Set to "true" when your provider requires TLS without a CA bundle (e.g. some poolers).
DATABASE_SSL=false
# Maximum pool connections per server instance.
DATABASE_POOL_MAX=10
# Run pending migrations automatically on first connection (default true).
# Set to false and run `npm run db:migrate` during deploys if you prefer.
VYBE_AUTO_MIGRATE=true
# Create the eight labelled demo profiles on first start (default true).
VYBE_SEED_DEMO=true
# Directory for the embedded database and local uploads (default .data).
VYBE_DATA_DIR=.data

# --- Storage ----------------------------------------------------------------
# "local" (files under VYBE_DATA_DIR/uploads) or "supabase" (Supabase Storage).
STORAGE_DRIVER=local
# Supabase Storage (only when STORAGE_DRIVER=supabase). Create a PRIVATE bucket;
# files are always served through /api/files, which enforces visibility.
SUPABASE_URL=
# SERVER ONLY. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vybe-media

# Upload size limits in MB (fair-use safety limits, the same for everyone).
UPLOAD_IMAGE_MAX_MB=15
UPLOAD_VIDEO_MAX_MB=80
UPLOAD_AUDIO_MAX_MB=20
UPLOAD_FONT_MAX_MB=4

# --- Email (password reset) ---------------------------------------------------
# Resend API key and a verified sender, e.g. "VYBE <hello@your-domain>".
# Without these, reset links are shown on screen in development only.
RESEND_API_KEY=
EMAIL_FROM=
