{
  "name": "vybe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VYBE — cinematic link-in-bio platform where every customization feature is free",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --experimental-strip-types scripts/db.ts migrate",
    "db:seed": "node --experimental-strip-types scripts/db.ts seed",
    "admin:grant": "node --experimental-strip-types scripts/db.ts grant-admin",
    "icons:generate": "node scripts/generate-brand-icons.mjs > src/features/socials/brand-icons.generated.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
